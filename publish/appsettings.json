{
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SQL_SERVER;Database=YOUR_DATABASE;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Scheduler": {
    "PollSeconds": 60,
    "MaxFutureMonths": 4,
    "RunTimeoutMinutes": 180,
    "RetryFailedAfterMinutes": 120,
    "MaxFailedRetries": 999,
    "CompletionPollSeconds": 5,
    "LaunchGraceSeconds": 180,
    "ShutdownTimeoutSeconds": 10,
    "AllowParallelRuns": true,
    "ResumeRunningJobsOnStartup": true,
    "KillPowerAutomateOnFailure": true,
    "AutoConfirmRunFlowDialog": true,
    "RunFlowDialogPollMs": 1000,
    "DisableExternalRunConfirmation": true,
    "HidePowerAutomateWindows": true,
    "PowerAutomateScriptsRoot": "",
    "TypesThatReadOwnParameters": [
      "CBS"
    ],
    "RunForever": true,
    "IgnoredJobIds": [],
    "PythonExecutable": "YOUR_DEPLOY_ROOT\\python\\.venv\\Scripts\\python.exe",
    "PythonJobs": [
      {
        "Action": "KLIRONOMIKES_KATAGRAFI_CEPAL",
        "WorkingDirectory": "YOUR_DEPLOY_ROOT\\python\\katagrafi_cepal",
        "Arguments": "main.py --scheduled"
      },
      {
        "Action": "KLIRONOMIKES_AGORA_PARAVOLON",
        "WorkingDirectory": "YOUR_DEPLOY_ROOT\\python\\agora_paravolon_klironomikes",
        "Arguments": "main.py --scheduled"
      },
      {
        "Action": "DIKASTIRIA_AGORA_PARAVOLON",
        "WorkingDirectory": "YOUR_DEPLOY_ROOT\\python\\agora_paravolon_dikastiria",
        "Arguments": "main.py --scheduled"
      }
    ]
  },
  "Logging": {
    "ToFile": true,
    "Directory": "Logs",
    "RetainDays": 30
  }
}
